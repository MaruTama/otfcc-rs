# c2rust migration: the Rust source (src/, Cargo.toml, ...) IS committed —
# it's the checked-in Rust port, not a build artifact regenerated per CI
# run (it used to live nested under rust/ before that directory was hoisted
# to the repo root once the C implementation was fully retired; see
# RUST_MIGRATION.md). Only its build output and the host-specific compile
# database aren't.
compile_commands.json
target/

# Makefile is for local dev only
makefile
.compile_commands.native.json

# Claude Code harness state (agent worktrees, etc.) -- not repo content
.claude/
